{
  "name": "gyrogon-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "dev:frontend": "pnpm --filter @gyrogon/frontend dev",
    "dev:backend": "pnpm --filter @gyrogon/backend dev",
    "build": "pnpm --filter @gyrogon/game-core build && pnpm --filter @gyrogon/backend build && pnpm --filter @gyrogon/frontend build",
    "test": "pnpm --filter @gyrogon/game-core test && pnpm --filter @gyrogon/backend test",
    "typecheck": "pnpm -r run typecheck",
    "db:generate": "pnpm --filter @gyrogon/backend db:generate",
    "db:migrate": "pnpm --filter @gyrogon/backend db:migrate",
    "db:seed": "pnpm --filter @gyrogon/backend db:seed"
  }
}
