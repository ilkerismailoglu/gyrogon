# GYROGON (gyrogon.com) Production Environment Configuration
# Copy to .env.production on your VPS and fill in real secrets before running ./deploy/deploy.sh

GYROGON_DOMAIN=gyrogon.com
NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://gyrogon.com,https://www.gyrogon.com

# PostgreSQL 16 (Internal Docker Network only - never exposed publicly)
POSTGRES_USER=gyrogon
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=gyrogon
DATABASE_URL=postgres://gyrogon:CHANGE_ME_STRONG_POSTGRES_PASSWORD@postgres:5432/gyrogon

# Redis 7 (Internal Docker Network only)
REDIS_URL=redis://redis:6379

# Cryptographic Signing Secrets (generate with: openssl rand -hex 32)
SESSION_SECRET=CHANGE_ME_64_HEX_SESSION_SECRET
JWT_SECRET=CHANGE_ME_64_HEX_JWT_SECRET
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
VITE_ADMIN_PATH=/gx-ctrl-9472

# Social Login Providers (Optional until enabled on Play Console / App Store)
APPLE_CLIENT_ID=com.gyrogon.game
GOOGLE_CLIENT_ID=
FACEBOOK_APP_SECRET=

# Password Reset Email (Configure either RESEND_API_KEY or SMTP_* variables)
MAIL_FROM=GYROGON <noreply@gyrogon.com>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
